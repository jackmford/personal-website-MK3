<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog - Jack Mitchell Fordyce</title>
    <link rel='icon' href='/static/img/cartoonprof.png' type='image/x-icon'>
    <link rel='stylesheet' href='/static/css/index.css'>
</head>
<body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="container">
        <div class="title-bar">
            <div class="buttons">
                <div class="button"></div>
                <div class="button yellow"></div>
                <div class="button green"></div>
            </div>
            <span>Blog - Jack Mitchell Fordyce</span>
        </div>
        <main class="window-content" id="content">
            <a class="back-link" href="/">&larr; Home</a>
            <div class="blog-posts" aria-label="Blog posts">
                {{range .Posts}}
                <article class="blog-post-preview">
                    <div class="post-meta"><time datetime="{{.Date.Format "2006-01-02"}}">{{.Date.Format "January 2, 2006"}}</time></div>
                    <h2><a href="/blog/{{.Slug}}">{{.Title}} <span aria-hidden="true">&rarr;</span></a></h2>
                    <p class="post-preview">{{.Preview}}</p>
                </article>
                {{end}}
            </div>
        </main>
        <footer class="footer"><a href="/">&larr; Back to home</a><span>&copy; 2026 Jack Mitchell Fordyce</span></footer>
    </div>
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "77f2e75dd46d4bc0bcbbf4a09ee7549e"}'></script>
</body>
</html> 
