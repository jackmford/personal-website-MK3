<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.Post.Title}} - Jack Mitchell Fordyce</title>
    <link rel='icon' href='/static/img/cartoonprof.png' type='image/x-icon'>
    <link rel='stylesheet' href='/static/css/index.css'>
</head>
<body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="container">
        <div class="title-bar">
            <div class="buttons">
                <div class="button"></div>
                <div class="button yellow"></div>
                <div class="button green"></div>
            </div>
            <span>Blog - Jack Mitchell Fordyce</span>
        </div>
        <main class="window-content" id="content">
            <article class="blog-post">
                <a class="back-link" href="/blog">&larr; All blog posts</a>
                <p class="eyebrow">Article</p>
                <h1>{{.Post.Title}}</h1>
                <p class="post-dek">{{.Post.Preview}}</p>
                <div class="post-meta"><time datetime="{{.Post.Date.Format "2006-01-02"}}">{{.Post.Date.Format "January 2, 2006"}}</time></div>
                <div class="post-content">
                    {{.Post.Content | safeHTML}}
                </div>
            </article>
        </main>
        <footer class="footer"><a href="/blog">&larr; All blog posts</a><a href="/">Home</a><span>&copy; 2026 Jack Mitchell Fordyce</span></footer>
    </div>
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "77f2e75dd46d4bc0bcbbf4a09ee7549e"}'></script>
</body>
</html> 
